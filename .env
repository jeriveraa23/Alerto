# PostgreSQL
POSTGRES_USER=alerto
POSTGRES_PASSWORD=alerto123
POSTGRES_DB=alerto_db
DB_HOST=postgres
DB_PORT=5432

# Airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://alerto:alerto123@postgres:5432/alerto_db
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__FERNET_KEY=<generarlo>
AIRFLOW__WEBSERVER__SECRET_KEY=<generarlo>

# Backend
DATABASE_URL=postgresql+asyncpg://alerto:alerto123@postgres:5432/alerto_db